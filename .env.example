# Copy to .env (gitignored) for local runs: `set -a; source .env; set +a`
# On CAI, set these as project environment variables instead.
MULE_IMPALA_USER=your-workload-username
MULE_IMPALA_PASSWORD=your-workload-password
HF_HOME=.hf_cache

# Air-gapped: a local copy of autogluon/mitra-classifier-2 (config.json + model.safetensors)
# MULE_MODEL_HF_MODEL=/home/cdsw/models/mitra-2

# CAI workbench (also the Airflow Variable MULE_CAI_HOST that triggers the daily scoring job)
MULE_CAI_HOST=https://federal-cml.federal.dp5i-5vkq.cloudera.site
# MULE_CAI_API_KEY=               # CAI API v2 key: User Settings > API Keys (never commit)

# After the CAI model is deployed (for the app's what-if tab)
# MULE_ENDPOINT_URL=https://modelservice.federal-cml.federal.dp5i-5vkq.cloudera.site/model
# MULE_ENDPOINT_ACCESS_KEY=
# MULE_ENDPOINT_API_KEY=
